rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() {
      return logado()
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    // Base de conhecimento: qualquer pessoa lê, só administradores alteram
    match /base/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // Lista de administradores: editada apenas pelo Console do Firebase
    match /config/admins {
      allow read: if logado();
      allow write: if false;
    }

    // Histórico: cada usuário lê e grava apenas os próprios diagnósticos
    match /data/users/{uid}/diagnosticos/{diag} {
      allow read, write: if logado() && request.auth.uid == uid;
    }
  }
}
